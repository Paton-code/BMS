<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paton.mapper.OperationLogMapper">
    <resultMap id="BaseResultMap" type="com.paton.domain.OperationLog">
        <id column="log_id" jdbcType="INTEGER" property="logId" />
        <result column="admin_id" jdbcType="INTEGER" property="adminId" />
        <result column="admin_name" jdbcType="VARCHAR" property="adminName" />
        <result column="operation_type" jdbcType="VARCHAR" property="operationType" />
        <result column="operation_module" jdbcType="VARCHAR" property="operationModule" />
        <result column="operation_description" jdbcType="VARCHAR" property="operationDescription" />
        <result column="operation_target" jdbcType="VARCHAR" property="operationTarget" />
        <result column="operation_ip" jdbcType="VARCHAR" property="operationIp" />
        <result column="operation_time" jdbcType="TIMESTAMP" property="operationTime" />
        <result column="operation_result" jdbcType="VARCHAR" property="operationResult" />
        <result column="operation_details" jdbcType="VARCHAR" property="operationDetails" />
    </resultMap>

    <sql id="Example_Where_Clause">
        <where>
            <foreach collection="oredCriteria" item="criteria" separator="or">
                <if test="criteria.valid">
                    <trim prefix="(" prefixOverrides="and" suffix=")">
                        <foreach collection="criteria.criteria" item="criterion">
                            <choose>
                                <when test="criterion.noValue">
                                    and ${criterion.condition}
                                </when>
                                <when test="criterion.singleValue">
                                    and ${criterion.condition} #{criterion.value}
                                </when>
                                <when test="criterion.betweenValue">
                                    and ${criterion.condition} #{criterion.value} and #{criterion.secondValue}
                                </when>
                                <when test="criterion.listValue">
                                    and ${criterion.condition}
                                    <foreach close=")" collection="criterion.value" item="listItem" open="(" separator=",">
                                        #{listItem}
                                    </foreach>
                                </when>
                            </choose>
                        </foreach>
                    </trim>
                </if>
            </foreach>
        </where>
    </sql>

    <sql id="Base_Column_List">
        log_id, admin_id, admin_name, operation_type, operation_module, operation_description,
    operation_target, operation_ip, operation_time, operation_result, operation_details
    </sql>

    <select id="selectByExample" parameterType="com.paton.domain.OperationLogExample" resultMap="BaseResultMap">
        select
        <if test="distinct">
            distinct
        </if>
        <include refid="Base_Column_List" />
        from p_operation_log
        <if test="_parameter != null">
            <include refid="Example_Where_Clause" />
        </if>
        <if test="orderByClause != null">
            order by ${orderByClause}
        </if>
        <if test="limitStart != null and limitSize != null">
            limit #{limitStart}, #{limitSize}
        </if>
    </select>

    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from p_operation_log
        where log_id = #{logId,jdbcType=INTEGER}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
        delete from p_operation_log
        where log_id = #{logId,jdbcType=INTEGER}
    </delete>

    <insert id="insert" parameterType="com.paton.domain.OperationLog">
        insert into p_operation_log (log_id, admin_id, admin_name,
                                     operation_type, operation_module, operation_description,
                                     operation_target, operation_ip, operation_time,
                                     operation_result, operation_details)
        values (#{logId,jdbcType=INTEGER}, #{adminId,jdbcType=INTEGER}, #{adminName,jdbcType=VARCHAR},
                #{operationType,jdbcType=VARCHAR}, #{operationModule,jdbcType=VARCHAR}, #{operationDescription,jdbcType=VARCHAR},
                #{operationTarget,jdbcType=VARCHAR}, #{operationIp,jdbcType=VARCHAR}, #{operationTime,jdbcType=TIMESTAMP},
                #{operationResult,jdbcType=VARCHAR}, #{operationDetails,jdbcType=VARCHAR})
    </insert>

    <!-- 自定义查询方法 -->
    <select id="selectByAdminId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from p_operation_log
        where admin_id = #{adminId,jdbcType=INTEGER}
        order by operation_time DESC
    </select>

    <select id="selectByTimeRange" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from p_operation_log
        where operation_time between #{startTime} and #{endTime}
        order by operation_time DESC
    </select>

    <select id="selectLatestLogs" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from p_operation_log
        order by operation_time DESC
        limit #{limit}
    </select>

    <!-- 添加缺失的countByExample方法 -->
    <select id="countByExample" parameterType="com.paton.domain.OperationLogExample" resultType="java.lang.Integer">
        select count(*) from p_operation_log
        <if test="_parameter != null">
            <include refid="Example_Where_Clause" />
        </if>
    </select>
</mapper>